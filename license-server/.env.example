# 监听端口与地址
PORT=8787
HOST=0.0.0.0

# 服务对外地址（用于拼易支付 notify_url；部署到域名后务必填写）
LICENSE_PUBLIC_URL=https://license.example.com

# 令牌签名密钥；留空会自动生成到 data/secret.txt
LICENSE_SECRET=

# 后台口令（不填则默认 admin123，务必修改）
LICENSE_ADMIN_PASSWORD=change-me-please

# 允许跨域的前端来源，逗号分隔；* 表示不限制
LICENSE_ALLOWED_ORIGINS=*

# 发信邮箱（QQ 邮箱用授权码，不是登录密码）
# QQ 邮箱：smtp.qq.com:465，SMTP_SECURE=1
# 163 邮箱：smtp.163.com:465
# Gmail：smtp.gmail.com:465
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=your@qq.com
SMTP_PASS=授权码
SMTP_FROM=your@qq.com
SMTP_FROM_NAME=无限画布

# 本地调试：把验证码直接回显在接口响应里（仅开发用，生产务必删掉）
LICENSE_DEV_ECHO_CODE=0

# 关闭请求日志
# LICENSE_LOG=0
